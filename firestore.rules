rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public data about servers can be read by anyone.
    match /discords/{serverId} {
      allow read: if true;
      allow write: if false;
    }
    
    // All data within a specific server should be accessible to authenticated users.
    // This is a broad rule but will unblock the current features.
    // We can refine this later if needed (e.g., role-based access).
    match /servers/{serverId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
