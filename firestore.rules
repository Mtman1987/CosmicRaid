rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isServerRequest() {
      // Server-side requests from Firebase Admin SDK bypass auth rules
      return request.auth == null;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // User sessions - allow server writes, client reads
    match /userSessions/{sessionId} {
      allow read, write: if true; // Allow all access for session management
    }
    
    // App config - allow server writes
    match /appConfig/{configId} {
      allow read, write: if true; // Allow all access for app configuration
    }
    
    // Public Discord server info
    match /discords/{discordId} {
      allow read: if true;
      allow write: if true; // Allow server writes
    }
    
    // Server data - allow all operations for server-side functions
    match /servers/{serverId} {
      allow read, write: if true; // Allow all access
      
      // All subcollections - allow full access
      match /{subcollection}/{docId} {
        allow read, write: if true;
        
        // Nested subcollections
        match /{nestedCollection}/{nestedDocId} {
          allow read, write: if true;
        }
      }
    }
    
    // Allow all other collections for server operations
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
