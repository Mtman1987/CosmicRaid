{
  "name": "cosmic-raid",
  "version": "0.1.0",
  "description": "Cosmic Raid Local Services - Puppeteer and FFmpeg processing for streamers",
  "author": "Mtman1987",
  "private": true,
  "scripts": {
    "space-mountain-dock": "node scripts/space-mountain-client.js",
    "dev-with-dock": "concurrently -k \"npm:space-mountain-dock\" \"next dev --port 3001\"",
    "dev": "electron development/electron-main.js",
    "dev:hosted": "node scripts/dev-hosted.js",
    "start:services": "node startup.js",
    "setup:scheduler": "node setup-cloud-scheduler.js",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev:hosted\" \"wait-on http://localhost:3300 && electron .\"",
    "electron:tunnel": "concurrently \"node scripts/start-with-tunnel.js\" \"wait-on http://localhost:3300 && electron .\"",
    "build:electron": "electron-builder",
    "dist": "npm run build && electron-builder",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "health-check": "node health-check.js",
    "tunnel:status": "node scripts/check-tunnel-status.js",
    "tunnel:start": "node start-tunnel.js",
    "local:service": "node development/local-services.js",
    "local:tunnel": "node development/start-local-with-tunnel.js",
    "service:start": "node simple-tunnel.js",
    "start:windows": "start-service.bat",
    "start:local": "start-local.bat",
    "test:images": "node scripts/test-image-generation.js"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.20.0",
    "@genkit-ai/next": "^1.20.0",
    "@google-cloud/secret-manager": "^5.6.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "discord-interactions": "^3.4.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.1.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.5.0",
    "genkit": "^1.20.0",
    "lucide-react": "^0.475.0",
    "next": "15.3.3",
    "next-themes": "^0.3.0",
    "node-fetch": "^3.3.2",
    "patch-package": "^8.0.0",
    "puppeteer": "^24.30.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tweetnacl": "^1.0.3",
    "zod": "^3.24.2"
  },
  "main": "development/electron-main.js",
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "18.3.26",
    "@types/react-dom": "^18",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "electron": "^39.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "9.38.0",
    "eslint-config-next": "16.0.0",
    "genkit-cli": "^1.20.0",
    "ngrok": "^4.3.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3",
    "wait-on": "^9.0.3",
    "ws": "^8.18.0"
  }
}
