rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isServerMember(serverId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/servers/$(serverId)/users/$(request.auth.uid));
    }
    
    function isServerAdmin(serverId) {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/servers/$(serverId)/users/$(request.auth.uid)).data.roles != null &&
             'admin' in get(/databases/$(database)/documents/servers/$(serverId)/users/$(request.auth.uid)).data.roles;
    }
    
    // Public Discord server info (read-only)
    match /discords/{discordId} {
      allow read: if true;
      allow write: if false; // Only server can write
    }
    
    // Server data
    match /servers/{serverId} {
      // Server document - members can read
      allow read: if isServerMember(serverId);
      allow write: if false; // Only server can write
      
      // Config subcollection - members can read
      match /config/{configDoc} {
        allow read: if isServerMember(serverId);
        allow write: if false; // Only server can write
      }
      
      // Users subcollection - members can read all users
      match /users/{userId} {
        allow read: if isServerMember(serverId);
        allow write: if false; // Only server can write
      }
      
      // Leaderboard entries - members can read
      match /leaderboard/{entryId} {
        allow read: if isServerMember(serverId);
        allow write: if false; // Only server can write
      }
      
      // Calendar events - members can read
      match /calendarEvents/{eventId} {
        allow read: if isServerMember(serverId);
        allow write: if false; // Only server can write
      }
      
      // Messages - members can read
      match /messages/{messageId} {
        allow read: if isServerMember(serverId);
        allow write: if false; // Only server can write
      }
      
      // Shoutout logs - members can read
      match /shoutoutLogs/{logId} {
        allow read: if isServerMember(serverId);
        allow write: if false; // Only server can write
      }
    }
    
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
